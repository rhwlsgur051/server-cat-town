# Production Environment Variables
# WARNING: Never commit this file with real credentials to git!

# Application
PORT=3000
NODE_ENV=production

# Database - UPDATE WITH PRODUCTION VALUES
DATABASE_HOST=your-prod-db-host
DATABASE_PORT=3306
DATABASE_USER=prod_user
DATABASE_PASSWORD=prod_password
DATABASE_NAME=cat_town_prod

# JWT
JWT_SECRET=your_production_jwt_secret_change_this_to_random_string
JWT_ACCESS_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# Logging
LOG_LEVEL=error

# CORS - UPDATE WITH YOUR PRODUCTION DOMAIN
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Add your production environment variables here
