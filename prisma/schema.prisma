// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  userNo    Int      @id @default(autoincrement()) @map("user_no")
  userId    String   @unique @map("user_id") @db.VarChar(50)
  userEmail String   @unique @map("user_email") @db.VarChar(100)
  userPwd   String   @map("user_pwd") @db.VarChar(255)
  userName  String   @map("user_name") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 1:N 관계 - 한 사용자는 여러 고양이를 가질 수 있음
  cats Cat[]
  
  // 1:N 관계 - 한 사용자는 여러 피드를 작성할 수 있음
  feeds Feed[]

  @@map("users")
}

model Cat {
  catNo     Int      @id @default(autoincrement()) @map("cat_no")
  catName   String   @map("cat_name") @db.VarChar(50)
  catBirth  String   @map("cat_birth") @db.VarChar(10) // YYYY-MM-DD
  catGender String   @map("cat_gender") @db.VarChar(10) // male | female
  catBreed  String   @map("cat_breed") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 외래키 - 어떤 사용자의 고양이인지
  userNo Int  @map("user_no")
  user   User @relation(fields: [userNo], references: [userNo], onDelete: Cascade)

  @@map("cats")
  @@index([userNo])
}

model Feed {
  feedNo       Int      @id @default(autoincrement()) @map("feed_no")
  feedContent  String   @map("feed_content") @db.Text // 글 내용
  feedImageUrl String?  @map("feed_image_url") @db.VarChar(500) // 이미지 URL (선택)
  feedLikes    Int      @default(0) @map("feed_likes") // 좋아요 수
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // 외래키 - 어떤 사용자가 작성한 피드인지 (1:N)
  userNo Int  @map("user_no")
  user   User @relation(fields: [userNo], references: [userNo], onDelete: Cascade)

  @@map("feeds")
  @@index([userNo])
  @@index([createdAt]) // 최신순 정렬을 위한 인덱스
}
