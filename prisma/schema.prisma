// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  userNo    Int      @id @default(autoincrement()) @map("user_no")
  userId    String   @unique @map("user_id") @db.VarChar(50)
  userEmail String   @unique @map("user_email") @db.VarChar(100)
  userPwd   String   @map("user_pwd") @db.VarChar(255)
  userName  String   @map("user_name") @db.VarChar(50)
  userAvatarUrl String? @map("user_avatar_url") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 1:N 관계 - 한 사용자는 여러 고양이를 가질 수 있음
  cats Cat[]
  
  // 1:N 관계 - 한 사용자는 여러 피드를 작성할 수 있음
  feeds Feed[]
  
  // 1:N 관계 - 한 사용자는 여러 좋아요를 누를 수 있음
  feedLikes FeedLike[]

  @@map("users")
}

model Cat {
  catNo     Int      @id @default(autoincrement()) @map("cat_no")
  catName   String   @map("cat_name") @db.VarChar(50)
  catBirth  String   @map("cat_birth") @db.VarChar(10) // YYYY-MM-DD
  catGender String   @map("cat_gender") @db.VarChar(10) // male | female
  catBreed  String   @map("cat_breed") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 외래키 - 어떤 사용자의 고양이인지
  userNo Int  @map("user_no")
  user   User @relation(fields: [userNo], references: [userNo], onDelete: Cascade)

  @@map("cats")
  @@index([userNo])
}

model Feed {
  feedNo       Int      @id @default(autoincrement()) @map("feed_no")
  feedContent  String   @map("feed_content") @db.Text // 글 내용
  feedImageUrl String   @map("feed_image_url") @db.VarChar(500) // 이미지 URL (필수)
  feedType     String   @default("daily") @map("feed_type") @db.VarChar(20) // daily | health | question
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // 외래키 - 어떤 사용자가 작성한 피드인지 (1:N)
  userNo Int  @map("user_no")
  user   User @relation(fields: [userNo], references: [userNo], onDelete: Cascade)
  
  // 1:N 관계 - 한 피드는 여러 좋아요를 받을 수 있음
  likes FeedLike[]

  @@map("feeds")
  @@index([userNo])
  @@index([createdAt]) // 최신순 정렬을 위한 인덱스
}

// 피드 좋아요 관계 테이블 (중간 테이블)
model FeedLike {
  feedLikeNo Int      @id @default(autoincrement()) @map("feed_like_no")
  createdAt  DateTime @default(now()) @map("created_at")

  // 외래키 - 어떤 피드에 대한 좋아요인지
  feedNo Int  @map("feed_no")
  feed   Feed @relation(fields: [feedNo], references: [feedNo], onDelete: Cascade)

  // 외래키 - 누가 좋아요를 눌렀는지
  userNo Int  @map("user_no")
  user   User @relation(fields: [userNo], references: [userNo], onDelete: Cascade)

  @@unique([feedNo, userNo]) // 한 사용자는 같은 피드에 한 번만 좋아요 가능
  @@map("feed_likes")
  @@index([feedNo])
  @@index([userNo])
}
